{
  "id": "monomodule-fx",
  "name": "Monomodule FX",
  "abbrev": "MNMF",
  "version": "0.0.1",
  "description": "The Elektron Monomachine's FX machines, emulated at chip level (Monomodule by shnolk). Test build.",
  "author": "shnolk (Monomodule); Schwung port: legsmechanical",
  "license": "GPL-3.0",
  "dsp": "monomodule-fx.so",
  "api_version": 2,
  "assets": [
    {
      "path": "os",
      "label": "Monomachine OS",
      "extensions": [
        ".syx"
      ],
      "description": "Requires the Monomachine OS 1.32B file, a free download from Elektron.",
      "hint": "Download Elektron_SFX6-60_OS1.32B.zip from elektron.se, unzip it and upload the .syx file.",
      "hint_url": "https://www.elektron.se/wp-content/uploads/2024/09/Elektron_SFX6-60_OS1.32B.zip",
      "hint_url_label": "Download (Elektron)",
      "files": [
        {
          "filename": "Elektron_SFX6-60_OS1.32B.syx",
          "label": "Monomachine OS 1.32B",
          "size": 903066,
          "required": true
        }
      ]
    },
    {
      "path": "dumps",
      "label": "Monomachine sysex dumps",
      "extensions": [
        ".syx"
      ],
      "optional": true,
      "description": "Optional: kit dumps from a Monomachine (.syx). Every sound in them appears in the Presets browser of Monomodule One (synth sounds) and Monomodule FX (FX sounds)."
    }
  ],
